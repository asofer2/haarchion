rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any Firebase Auth session (Google sign-in on the site)
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Public archive — anyone may read; signed-in editors may write
    match /people/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /productions/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /credits/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /contributions/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Editor profiles (Google sign-in metadata) — own doc only
    match /editors/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
